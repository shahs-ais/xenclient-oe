+bool efi_secureboot_enabled(void)
+{
+    EFI_GUID efi_gv = EFI_GLOBAL_VARIABLE;
+    static CHAR16 __initdata str_SecureBoot[] = L"SecureBoot";
+    static CHAR16 __initdata str_SetupMode[] = L"SetupMode";
+    UINT8 SecureBoot = 0, SetupMode = 0;
+    UINTN DataSize = sizeof(SecureBoot);
+    EFI_STATUS efi_status;
+
+    efi_status = efi_rs->GetVariable(str_SecureBoot, &efi_gv, NULL,
+                                     &DataSize, &SecureBoot);
+    if ( EFI_ERROR(efi_status) )
+        return false;
+
+    if ( !SecureBoot )
+        return false;
+
+    efi_status = efi_rs->GetVariable(str_SetupMode, &efi_gv, NULL,
+                                     &DataSize, &SetupMode);
+    if ( EFI_ERROR(efi_status) )
+        return false;
+
+    if ( SetupMode )
+        return false;
+
+    return true;
+}
